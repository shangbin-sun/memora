# 复制为 .env 后填写，勿提交真实密钥
LLM_API_KEY=
LLM_CHAT_URL=https://qianfan.baidubce.com/v2/chat/completions
LLM_EMBED_URL=https://qianfan.baidubce.com/v2/embeddings
LLM_CHAT_MODEL=qwen3.5-27b
LLM_EMBED_MODEL=qwen3-embedding-8b
LLM_EMBED_DIM=4096

# memora-server（可选）
# MEMORA_BIND=127.0.0.1:8787
# MEMORA_DB=data/memora.db
# MEMORA_NAMESPACE=default
# 后台 tick 间隔（秒）；默认 600；设为 0 关闭
# MEMORA_TICK_INTERVAL=600
# 后台 dream 间隔（秒）；默认 180；设为 0 关闭
# MEMORA_DREAM_INTERVAL=180
# 嵌入后端：auto | hash | llm | qianfan（向量只走 LLM embeddings）
# MEMORA_EMBEDDER=llm
